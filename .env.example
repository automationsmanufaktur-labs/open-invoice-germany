# ── OpenInvoice Germany — Beispiel-Umgebung ──────────────────────────────
# Kopiere diese Datei nach .env und passe die Werte an.

# Datenbank ---------------------------------------------------------------
# Solo/Dev (Default): lokale SQLite-Datei, kein Server nötig.
DATABASE_URL="file:./dev.db"
#
# Postgres (Docker/Prod): siehe docker-compose.yml + prisma/schema.postgres.prisma
# DATABASE_URL="postgresql://oig:oig@localhost:5432/openinvoice?schema=public"

# Anmeldung ---------------------------------------------------------------
# Signiert die Session-Cookies UND dient als Schlüssel für verschlüsselt gespeicherte
# SMTP-Passwörter (Einstellungen → E-Mail-Versand). In PRODUKTION zwingend mit starkem
# Zufallswert setzen:
#   openssl rand -base64 32
# Ein späterer Wechsel invalidiert das gespeicherte SMTP-Passwort — danach in den
# Mail-Einstellungen neu eintragen. Verschlüsselt außerdem die Angebotslink-Token
# (QuoteShareLink.tokenEnc) für den Betreiber-Wiederabruf ("Link anzeigen"); ein
# Wechsel macht bestehende Links dort unlesbar (die Online-Annahme selbst bleibt
# funktionsfähig, da dafür nur der SHA-256-Hash gebraucht wird).
AUTH_SECRET=""

# Basis-URL (optional) -----------------------------------------------------
# Fuer den Angebotsannahme-Link (/angebot/<token>). Ohne diese Variable wird die
# Basis-URL aus den Request-Headern rekonstruiert (x-forwarded-proto + host) — in
# Produktion hinter einem Reverse-Proxy empfohlen, explizit zu setzen:
# APP_BASE_URL="https://invoice.prepaid-host.com"

# Abo-Cron (optional) -----------------------------------------------------
# Schützt GET/POST /api/cron/run-recurring. Ist der Wert gesetzt, muss der Aufruf
#   Authorization: Bearer <CRON_SECRET>   (oder ?secret=…)
# mitliefern. Für öffentliche Deployments dringend setzen.
# CRON_SECRET=""

# E-Rechnung-Validierung (optional) --------------------------------------
# Mustangproject-Sidecar (Docker) für XRechnung/ZUGFeRD-Erzeugung & -Validierung.
# Ohne diesen Dienst kann die App nur "sonstige Rechnungen" (PDF) ausstellen.
# EINVOICE_SERVICE_URL="http://localhost:8085"

# E-Mail-Versand -----------------------------------------------------------
# Keine Umgebungsvariablen nötig: SMTP-Host, Port, Zugangsdaten und Absender werden
# unter Einstellungen → E-Mail-Versand konfiguriert (Passwort verschlüsselt in der
# Datenbank, siehe AUTH_SECRET oben). Siehe README, Abschnitt "E-Mail-Versand einrichten".
