# ── OpenInvoice Germany — Beispiel-Umgebung ──────────────────────────────
# Kopiere diese Datei nach .env und passe die Werte an.

# Datenbank ---------------------------------------------------------------
# Solo/Dev (Default): lokale SQLite-Datei, kein Server nötig.
DATABASE_URL="file:./dev.db"
#
# Postgres (Docker/Prod): siehe docker-compose.yml + prisma/schema.postgres.prisma
# DATABASE_URL="postgresql://oig:oig@localhost:5432/openinvoice?schema=public"

# Anmeldung ---------------------------------------------------------------
# Signiert die Session-Cookies UND dient als Schlüssel für verschlüsselt gespeicherte
# SMTP-Passwörter (Einstellungen → E-Mail-Versand). In PRODUKTION zwingend mit starkem
# Zufallswert setzen:
#   openssl rand -base64 32
# Ein späterer Wechsel invalidiert das gespeicherte SMTP-Passwort — danach in den
# Mail-Einstellungen neu eintragen. Verschlüsselt außerdem die Angebotslink-Token
# (QuoteShareLink.tokenEnc) für den Betreiber-Wiederabruf ("Link anzeigen"); ein
# Wechsel macht bestehende Links dort unlesbar (die Online-Annahme selbst bleibt
# funktionsfähig, da dafür nur der SHA-256-Hash gebraucht wird). Verschlüsselt
# außerdem die Webhook-Endpunkt-Secrets (WebhookEndpoint.secretEnc, Phase 10) — ein
# Wechsel macht bestehende Webhook-Secrets unlesbar, betroffene Endpunkte müssen
# ihr Secret dann neu rotieren (Einstellungen → Webhooks).
AUTH_SECRET=""

# Basis-URL (optional) -----------------------------------------------------
# Fuer den Angebotsannahme-Link (/angebot/<token>). Ohne diese Variable wird die
# Basis-URL aus den Request-Headern rekonstruiert (x-forwarded-proto + host) — in
# Produktion hinter einem Reverse-Proxy empfohlen, explizit zu setzen:
# APP_BASE_URL="https://invoice.prepaid-host.com"

# Cron-Endpunkte (PFLICHT, wenn du /api/cron/* verwendest) ------------------
# Schützt GET/POST /api/cron/run-recurring, /api/cron/run-dunning, /api/cron/run-all.
# `/api/cron` ist bewusst NICHT sessiongeschützt (proxy.ts) — dieses Secret ist der
# einzige Schutz. Ohne gesetzten Wert antworten die Routen fail-closed mit 503 (Fix-Welle
# B3, vorher: ohne Secret anonym erreichbar). Der Aufruf muss
#   Authorization: Bearer <CRON_SECRET>   (oder ?secret=…)
# mitliefern. Für öffentliche Deployments zwingend setzen — sonst sind die Cron-Endpunkte
# schlicht gesperrt (nutzt du stattdessen nur den eingebauten Loop/`npm run scheduler:run`
# lokal, kannst du diese Variable leer lassen, dann bleiben nur die /api/cron-Routen tot).
CRON_SECRET=""

# Scheduler (Mahnwesen/Abos, Phase 6) ---------------------------------------
# Eingebauter Intervall-Loop im Node-Prozess (src/instrumentation.ts) — läuft zusätzlich zu
# den Cron-Endpunkten/CLI-Skripten (dieselbe Runner-Funktion, dasselbe SchedulerRun-Protokoll).
# Default AN (Opt-out, nicht Opt-in) — auf "false"/"0"/"no"/"off" setzen, um zu deaktivieren.
# SCHEDULER_ENABLED="true"
# Intervall in Minuten (Default 15, min. 1). Erster Lauf 60 s nach Prozessstart.
# SCHEDULER_INTERVAL_MINUTES="15"

# E-Rechnung-Validierung (optional) --------------------------------------
# Mustangproject-Sidecar (Docker) für XRechnung/ZUGFeRD-Erzeugung & -Validierung.
# Ohne diesen Dienst kann die App nur "sonstige Rechnungen" (PDF) ausstellen.
# EINVOICE_SERVICE_URL="http://localhost:8085"

# Beleganhaenge (optional) -------------------------------------------------
# Ablageverzeichnis fuer Datei-Anhaenge an Belegen (Phase 4b) — ausserhalb des
# Web-Roots. Default: ./data/attachments (relativ zum Prozessverzeichnis). Im
# Docker-Container: /app/data/attachments (Volume, siehe docker-compose.yml).
# ATTACHMENTS_DIR="./data/attachments"

# E-Mail-Versand -----------------------------------------------------------
# Keine Umgebungsvariablen nötig: SMTP-Host, Port, Zugangsdaten und Absender werden
# unter Einstellungen → E-Mail-Versand konfiguriert (Passwort verschlüsselt in der
# Datenbank, siehe AUTH_SECRET oben). Siehe README, Abschnitt "E-Mail-Versand einrichten".
